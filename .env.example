# Copy this file to .env and fill in your own values.
# docker compose reads .env from the same directory automatically.

# ---- Database server (MySQL / MariaDB) - required ----
# Run deploy/sql/multi-cloud-cdn-empty-install.sql first,
# then deploy/sql/init-data.sql, on this database server.
DB_URL=jdbc:mysql://your-db-host:3306/multi_cloud_cdn?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=cdn
DB_PASSWORD=change-me

# ---- Redis cache server - required ----
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- App ----
APP_PORT=8000
SERVER_PORT=8000
INSTALLATION_BOOTSTRAP_PASSWORD=Admin@123456
